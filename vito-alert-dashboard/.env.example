# ============================================
# VITO Alert Dashboard - configuración local
# ============================================
# Copiá este archivo a `.env` y completá los valores.
#
# `.env` NO se commitea: está en `.gitignore` y en el deploy de CI las
# variables se inyectan desde secrets de GitHub Actions.
#
# OJO — la publishable key de Supabase es una clave PÚBLICA: Vite la
# inlinea en el bundle y cualquiera que abra la página puede leerla.
# Esa clave NO es la frontera de seguridad. La frontera real es:
#   1) las policies de RLS de la base de datos, y
#   2) el gate de acceso de la Edge Function `panel-acceso`.
# Ver README.md y el runbook de publicación en el vault de Cortex.

# URL del proyecto Supabase
VITE_SUPABASE_URL=https://rkgbedehkfpiylaubjbo.supabase.co

# Publishable key (antes "anon key") de Supabase
VITE_SUPABASE_ANON_KEY=PEGAR_AQUI_LA_PUBLISHABLE_KEY

# Tabla de perfiles de usuario.
# En este proyecto es `perfil_usuario` (ver src/services/supabase/schema.sql).
# OJO: la tabla `perfiles` NO existe. Dejarla mal hace que la consulta de
# perfiles falle y el panel caiga a la lista de usuarios embebida.
VITE_PROFILES_TABLE=perfil_usuario

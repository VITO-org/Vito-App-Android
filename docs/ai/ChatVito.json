      "parameters": {
        "jsCode": "let requests = $(\"Download Document\").all()\nconst source = $('Chat Webhook').first().json.body\n\nrequests.forEach((request) => {\n  let mime_type = request.json.mime_type || source.mimeType\n\n  if (\n    mime_type === \"text/calendar\" ||\n    mime_type === \"application/ics\" ||\n    mime_type === \"text/x-calendar\"\n  ) {\n    mime_type = \"mapped/calendar\"\n  }\n\n  if (\n    mime_type === \"application/xml\" ||\n    mime_type === \"text/xml\") {\n    mime_type = \"mapped/xml\"\n  }\n\n  request.json.mime_type = mime_type\n})\n\nreturn requests;"
      },

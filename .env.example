# Credenciales del webhook del chat de VITO (Railway / n8n).
#
# Copiá este archivo a `.env` y completá los valores.
# `.env` está en .gitignore y NO se commitea.
#
# IMPORTANTE:
# Las variables con prefijo EXPO_PUBLIC_ se INLINEAN como literal en el bundle JS
# durante el build (ver babel.config.js → babel-preset-expo). Eso significa que
# NO son secretos: viajan dentro del APK y cualquiera puede extraerlos.
# Si en el futuro el valor debe ser realmente secreto, no va aquí: tiene que
# quedar en un backend (Edge Function de Supabase) y la app solo manda su JWT.

# Nombre del header HTTP de autenticación (ej: x-api-key, x-vito-token)
EXPO_PUBLIC_CHAT_AUTH_HEADER_NAME=

# Valor del header HTTP de autenticación
EXPO_PUBLIC_CHAT_AUTH_HEADER_VALUE=

{
  "hosting": {
    "target": "default-site",
    "public": "hosting-redirect",
    "ignore": ["firebase.json", "firebase.redirect.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "**",
        "destination": "https://vito-oficial.web.app/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      }
    ]
  }
}

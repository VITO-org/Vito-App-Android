{
  "name": "Vito",
  "displayName": "Vito",
  "expo": {
    "name": "Vito",
    "slug": "vito-health-connect",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./src/assets/launcher-icon.png",
    "android": {
      "package": "com.vito.healthconnect.rn",
      "googleServicesFile": "./android/app/google-services.json",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-foreground.png",
        "backgroundColor": "#0E2A2D"
      },
      "permissions": [
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#2FAF7A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa67daf3-789f-4cc2-a373-ceb1507c4a50"
      }
    },
    "owner": "vito-proyecto"
  }
}
